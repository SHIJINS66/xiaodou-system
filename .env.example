# .env.example — 复制为 .env 后填写真实值，切勿提交到仓库
# ----------------------------------------------------------------
# 下面分出「核心必需」与「可选按需」两档。
# secrets.required_env 只强校验"核心必需"项；可选项缺省时对应功能降级/延迟。
# ----------------------------------------------------------------

# ---------- 核心必需（缺任一则 framework 拒绝启动） ----------

# 对话模型 / 自拍 spec 生成（选 DeepSeek 就填这个）
#   -> 可换 OpenRouter(OPENROUTER_API_KEY) 或豆包(ARK_API_KEY)，见 settings.yaml 的 models 段
DEEPSEEK_API_KEY=

# 消息分发（Telegram）：bot token（在 @BotFather 里拿）
TELEGRAM_BOT_TOKEN=

# 主动消息发往哪个 chat：你（陪伴对象）的 Telegram 用户 id（整数）
TELEGRAM_CHAT_ID=

# ---------- 可选按需（缺省时对应功能降级/延迟，不影响核心流程） ----------

# 图像生成 / 自拍（Seedream / 豆包方舟）。不配则自拍事件按降级规则处理。
ARK_API_KEY=

# OpenClaw gateway 的访问 token（framework 把主动消息摘要注入 session 历史时用）。
# 一般与 OpenClaw 实例里 gateway.auth.token 一致。不配则注入步骤会失败、由重试机制处理。
# OPENCLAW_GATEWAY_TOKEN=

# 出网代理（仅当你的机器无法直连 Telegram / 模型 API 时设置，例如测试机被墙）。
# HTTP_PROXY=http://127.0.0.1:10800
# HTTPS_PROXY=http://127.0.0.1:10800
