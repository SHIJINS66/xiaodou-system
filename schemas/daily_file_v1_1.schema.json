{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaodou.local/schemas/daily_file_v1_1.schema.json",
  "title": "护卫每日运行文件 v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "timezone",
    "plan_status",
    "file_revision",
    "created_at",
    "updated_at",
    "source_fingerprints",
    "plan",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "plan_status": {
      "enum": [
        "draft",
        "validated",
        "scheduled",
        "active",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "file_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    }
  },
  "$defs": {
    "plan_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "plan_mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valence",
        "arousal",
        "label"
      ],
      "properties": {
        "valence": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "arousal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "plan_timeline_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_at",
        "end_at",
        "location_type",
        "location_label",
        "activity",
        "reply_state",
        "mood",
        "attire",
        "continuity_note"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^s[0-9]{2}$"
        },
        "start_at": {
          "$ref": "#/$defs/plan_timestamp"
        },
        "end_at": {
          "$ref": "#/$defs/plan_timestamp"
        },
        "location_type": {
          "enum": [
            "home",
            "subway",
            "office",
            "outside",
            "cinema",
            "supermarket",
            "restaurant",
            "wuhan_home",
            "other"
          ]
        },
        "location_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reply_state": {
          "enum": [
            "available",
            "available_short_reply",
            "commuting_chatty",
            "focused_no_reply",
            "sleeping",
            "washing_no_reply",
            "resting_low_contact",
            "overtime_low_contact"
          ]
        },
        "mood": {
          "$ref": "#/$defs/plan_mood"
        },
        "attire": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "continuity_note": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "plan_time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest_at",
        "preferred_at",
        "latest_at"
      ],
      "properties": {
        "earliest_at": {
          "$ref": "#/$defs/plan_timestamp"
        },
        "preferred_at": {
          "$ref": "#/$defs/plan_timestamp"
        },
        "latest_at": {
          "$ref": "#/$defs/plan_timestamp"
        }
      }
    },
    "plan_message_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reply_pressure",
        "must_reference_current_activity"
      ],
      "properties": {
        "reply_pressure": {
          "enum": [
            "none",
            "low",
            "normal"
          ]
        },
        "must_reference_current_activity": {
          "type": "boolean"
        }
      }
    },
    "plan_selfie_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "framing",
        "location",
        "outfit",
        "pose",
        "expression",
        "lighting",
        "background",
        "reference_images_required"
      ],
      "properties": {
        "camera": {
          "enum": [
            "front_camera",
            "mirror",
            "other"
          ]
        },
        "framing": {
          "enum": [
            "close_up",
            "head_and_shoulders",
            "half_body",
            "full_body"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "outfit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "pose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lighting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reference_images_required": {
          "const": true
        },
        "negative_constraints": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "plan_planner_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "origin",
        "created_at",
        "created_by",
        "runtime_reason",
        "supersedes_event_id",
        "type",
        "segment_id",
        "time_window",
        "priority",
        "intent",
        "topic_seed",
        "message_constraints",
        "context_requirements",
        "cancel_conditions"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9]{8}-e[0-9]{2}$"
        },
        "origin": {
          "const": "planner"
        },
        "created_at": {
          "$ref": "#/$defs/plan_timestamp"
        },
        "created_by": {
          "const": "planner"
        },
        "runtime_reason": {
          "type": "null"
        },
        "supersedes_event_id": {
          "type": "null"
        },
        "type": {
          "enum": [
            "silent",
            "chat",
            "status",
            "selfie"
          ]
        },
        "segment_id": {
          "type": "string",
          "pattern": "^s[0-9]{2}$"
        },
        "time_window": {
          "$ref": "#/$defs/plan_time_window"
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "topic_seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "message_constraints": {
          "$ref": "#/$defs/plan_message_constraints"
        },
        "context_requirements": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "enum": [
              "latest_chatlog",
              "latest_daily_memory",
              "current_reply_state",
              "user_busy_state",
              "unanswered_outbound_count",
              "previous_event_result",
              "weather"
            ]
          }
        },
        "cancel_conditions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "enum": [
              "sleeping",
              "focused",
              "washing",
              "user_dnd",
              "user_busy_and_low_priority",
              "three_unanswered",
              "context_conflict",
              "late_execution",
              "selfie_generation_failed"
            ]
          }
        },
        "selfie_spec": {
          "$ref": "#/$defs/plan_selfie_spec"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "selfie"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selfie_spec"
            ]
          },
          "else": {
            "not": {
              "required": [
                "selfie_spec"
              ]
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "date",
        "timezone",
        "day_context",
        "interaction_budget",
        "timeline",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": "1.1"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "const": "Asia/Shanghai"
        },
        "day_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "day_type",
            "workload",
            "health_state",
            "weather_summary",
            "day_theme",
            "exception_reason"
          ],
          "properties": {
            "day_type": {
              "enum": [
                "workday",
                "weekend",
                "holiday",
                "leave",
                "travel",
                "sick"
              ]
            },
            "workload": {
              "enum": [
                "light",
                "normal",
                "busy",
                "month_end",
                "quarter_end",
                "year_end",
                "overtime"
              ]
            },
            "health_state": {
              "enum": [
                "normal",
                "tired",
                "menstrual_mild",
                "unwell"
              ]
            },
            "weather_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "day_theme": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "exception_reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            }
          }
        },
        "interaction_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_target",
            "chat_target",
            "status_target",
            "selfie_target",
            "silent_target"
          ],
          "properties": {
            "total_target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "chat_target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "status_target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "selfie_target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "silent_target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "timeline": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/plan_timeline_segment"
          }
        },
        "events": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/plan_planner_event"
          }
        }
      }
    },
    "runtime_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valence",
        "arousal",
        "label"
      ],
      "properties": {
        "valence": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "arousal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "runtime_timeline_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_at",
        "end_at",
        "location_type",
        "location_label",
        "activity",
        "reply_state",
        "mood",
        "attire",
        "continuity_note"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^s[0-9]{2}$"
        },
        "start_at": {
          "$ref": "#/$defs/runtime_timestamp"
        },
        "end_at": {
          "$ref": "#/$defs/runtime_timestamp"
        },
        "location_type": {
          "enum": [
            "home",
            "subway",
            "office",
            "outside",
            "cinema",
            "supermarket",
            "restaurant",
            "wuhan_home",
            "other"
          ]
        },
        "location_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reply_state": {
          "enum": [
            "available",
            "available_short_reply",
            "commuting_chatty",
            "focused_no_reply",
            "sleeping",
            "washing_no_reply",
            "resting_low_contact",
            "overtime_low_contact"
          ]
        },
        "mood": {
          "$ref": "#/$defs/runtime_mood"
        },
        "attire": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "continuity_note": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "runtime_time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest_at",
        "preferred_at",
        "latest_at"
      ],
      "properties": {
        "earliest_at": {
          "$ref": "#/$defs/runtime_timestamp"
        },
        "preferred_at": {
          "$ref": "#/$defs/runtime_timestamp"
        },
        "latest_at": {
          "$ref": "#/$defs/runtime_timestamp"
        }
      }
    },
    "runtime_message_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reply_pressure",
        "must_reference_current_activity"
      ],
      "properties": {
        "reply_pressure": {
          "enum": [
            "none",
            "low",
            "normal"
          ]
        },
        "must_reference_current_activity": {
          "type": "boolean"
        }
      }
    },
    "runtime_selfie_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "framing",
        "location",
        "outfit",
        "pose",
        "expression",
        "lighting",
        "background",
        "reference_images_required"
      ],
      "properties": {
        "camera": {
          "enum": [
            "front_camera",
            "mirror",
            "other"
          ]
        },
        "framing": {
          "enum": [
            "close_up",
            "head_and_shoulders",
            "half_body",
            "full_body"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "outfit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "pose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lighting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reference_images_required": {
          "const": true
        },
        "negative_constraints": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "runtime_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "origin",
        "created_at",
        "created_by",
        "runtime_reason",
        "supersedes_event_id",
        "type",
        "segment_id",
        "time_window",
        "priority",
        "intent",
        "topic_seed",
        "message_constraints",
        "context_requirements",
        "cancel_conditions"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9]{8}-r[0-9]{2}$"
        },
        "origin": {
          "const": "runtime"
        },
        "created_at": {
          "$ref": "#/$defs/runtime_timestamp"
        },
        "created_by": {
          "enum": [
            "event_executor",
            "openclaw_agent",
            "manual_runtime"
          ]
        },
        "runtime_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{8}-[er][0-9]{2}$"
        },
        "type": {
          "enum": [
            "silent",
            "chat",
            "status",
            "selfie"
          ]
        },
        "segment_id": {
          "type": "string",
          "pattern": "^s[0-9]{2}$"
        },
        "time_window": {
          "$ref": "#/$defs/runtime_time_window"
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "topic_seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "message_constraints": {
          "$ref": "#/$defs/runtime_message_constraints"
        },
        "context_requirements": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "enum": [
              "latest_chatlog",
              "latest_daily_memory",
              "current_reply_state",
              "user_busy_state",
              "unanswered_outbound_count",
              "previous_event_result",
              "weather"
            ]
          }
        },
        "cancel_conditions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "enum": [
              "sleeping",
              "focused",
              "washing",
              "user_dnd",
              "user_busy_and_low_priority",
              "three_unanswered",
              "context_conflict",
              "late_execution",
              "selfie_generation_failed"
            ]
          }
        },
        "selfie_spec": {
          "$ref": "#/$defs/runtime_selfie_spec"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "selfie"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selfie_spec"
            ]
          },
          "else": {
            "not": {
              "required": [
                "selfie_spec"
              ]
            }
          }
        }
      ]
    },
    "nullable_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "error_state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "attempts"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "history_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "from_status",
        "to_status",
        "reason"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "from_status": {
          "enum": [
            null,
            "planned",
            "scheduling",
            "scheduled",
            "cancelling",
            "running",
            "completed",
            "cancelled",
            "failed",
            "skipped"
          ]
        },
        "to_status": {
          "enum": [
            "planned",
            "scheduling",
            "scheduled",
            "cancelling",
            "running",
            "completed",
            "cancelled",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "event_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "status",
        "scheduled_for",
        "at_job_id",
        "attempt_count",
        "decision",
        "decision_reason",
        "started_at",
        "completed_at",
        "final_text",
        "output_image",
        "telegram_sent",
        "session_injected",
        "error",
        "history"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9]{8}-[er][0-9]{2}$"
        },
        "status": {
          "enum": [
            "planned",
            "scheduling",
            "scheduled",
            "cancelling",
            "running",
            "completed",
            "cancelled",
            "failed",
            "skipped"
          ]
        },
        "scheduled_for": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "at_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "decision": {
          "enum": [
            "pending",
            "execute",
            "adjust",
            "delay",
            "cancel"
          ]
        },
        "decision_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "final_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "telegram_sent": {
          "type": "boolean"
        },
        "session_injected": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/error_state"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/history_item"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "scheduling",
        "current_state",
        "user_context",
        "runtime_events",
        "event_states",
        "daily_memory"
      ],
      "properties": {
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "validated_at",
            "errors",
            "warnings"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "validated_at": {
              "$ref": "#/$defs/nullable_timestamp"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scheduled_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "scheduled",
                "partial",
                "failed"
              ]
            },
            "scheduled_at": {
              "$ref": "#/$defs/nullable_timestamp"
            }
          }
        },
        "current_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment_id",
            "reply_state",
            "updated_at"
          ],
          "properties": {
            "segment_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reply_state": {
              "enum": [
                "available",
                "available_short_reply",
                "commuting_chatty",
                "focused_no_reply",
                "sleeping",
                "washing_no_reply",
                "resting_low_contact",
                "overtime_low_contact"
              ]
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "user_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared_busy",
            "busy_until",
            "do_not_disturb",
            "unanswered_outbound_count",
            "last_user_message_at",
            "last_outbound_at"
          ],
          "properties": {
            "declared_busy": {
              "type": "boolean"
            },
            "busy_until": {
              "$ref": "#/$defs/nullable_timestamp"
            },
            "do_not_disturb": {
              "type": "boolean"
            },
            "unanswered_outbound_count": {
              "type": "integer",
              "minimum": 0
            },
            "last_user_message_at": {
              "$ref": "#/$defs/nullable_timestamp"
            },
            "last_outbound_at": {
              "$ref": "#/$defs/nullable_timestamp"
            }
          }
        },
        "runtime_events": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/runtime_event"
          }
        },
        "event_states": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/event_state"
          }
        },
        "daily_memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "generated_at",
            "path",
            "error"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "generated",
                "failed"
              ]
            },
            "generated_at": {
              "$ref": "#/$defs/nullable_timestamp"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "$ref": "#/$defs/error_state"
            }
          }
        }
      }
    }
  }
}
