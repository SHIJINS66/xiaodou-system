{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev-[a-f0-9]{24}$"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_life",
    "proactive_shares",
    "companion_responses",
    "important_conversations",
    "emotional_and_relationship_notes",
    "unresolved_items",
    "tomorrow_implications",
    "long_term_memory_candidates"
  ],
  "properties": {
    "actual_life": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "proactive_shares": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "companion_responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "important_conversations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "emotional_and_relationship_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "tomorrow_implications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    },
    "long_term_memory_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 12
    }
  }
}
