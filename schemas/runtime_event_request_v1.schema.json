{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaodou.local/schemas/runtime_event_request_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["created_by", "runtime_reason", "supersedes_event_id", "type", "segment_id", "time_window", "priority", "intent", "topic_seed", "message_constraints", "context_requirements", "cancel_conditions"],
  "properties": {
    "created_by": {"enum": ["event_executor", "openclaw_agent", "manual_runtime"]},
    "runtime_reason": {"type": "string", "minLength": 1, "maxLength": 220},
    "supersedes_event_id": {"type": ["string", "null"], "pattern": "^[0-9]{8}-[er][0-9]{2}$"},
    "type": {"enum": ["chat", "status", "selfie"]},
    "segment_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
    "time_window": {"type": "object", "additionalProperties": false, "required": ["earliest_at", "preferred_at", "latest_at"], "properties": {"earliest_at": {"type": "string", "format": "date-time"}, "preferred_at": {"type": "string", "format": "date-time"}, "latest_at": {"type": "string", "format": "date-time"}}},
    "priority": {"enum": ["low", "normal", "high"]},
    "intent": {"type": "string", "minLength": 1, "maxLength": 200},
    "topic_seed": {"type": "string", "minLength": 1, "maxLength": 240},
    "message_constraints": {"type": "object", "additionalProperties": false, "required": ["reply_pressure", "must_reference_current_activity"], "properties": {"reply_pressure": {"enum": ["none", "low", "normal"]}, "must_reference_current_activity": {"type": "boolean"}}},
    "context_requirements": {"type": "array", "uniqueItems": true, "maxItems": 10, "items": {"enum": ["latest_chatlog", "latest_daily_memory", "current_reply_state", "user_busy_state", "unanswered_outbound_count", "previous_event_result", "weather"]}},
    "cancel_conditions": {"type": "array", "uniqueItems": true, "maxItems": 12, "items": {"enum": ["sleeping", "focused", "washing", "user_dnd", "user_busy_and_low_priority", "three_unanswered", "context_conflict", "late_execution", "selfie_generation_failed"]}},
    "selfie_spec": {"type": "object", "additionalProperties": false, "required": ["camera", "framing", "location", "outfit", "pose", "expression", "lighting", "background", "reference_images_required"], "properties": {"camera": {"enum": ["front_camera", "mirror", "other"]}, "framing": {"enum": ["close_up", "head_and_shoulders", "half_body", "full_body"]}, "location": {"type": "string", "minLength": 1, "maxLength": 140}, "outfit": {"type": "string", "minLength": 1, "maxLength": 180}, "pose": {"type": "string", "minLength": 1, "maxLength": 160}, "expression": {"type": "string", "minLength": 1, "maxLength": 120}, "lighting": {"type": "string", "minLength": 1, "maxLength": 160}, "background": {"type": "string", "minLength": 1, "maxLength": 200}, "reference_images_required": {"const": true}, "negative_constraints": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 120}}}}
  },
  "allOf": [{"if": {"properties": {"type": {"const": "selfie"}}, "required": ["type"]}, "then": {"required": ["selfie_spec"]}, "else": {"not": {"required": ["selfie_spec"]}}}]
}
